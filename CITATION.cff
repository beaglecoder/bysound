    given-names: Agustin
    affiliation: beaglecoder
version: 4.0.0
date-released: 2026-11-25
license: MIT
repository-code: "https://github.com/beaglecoder/bysound"
keywords:
  - data-over-sound
  - acoustic communication
  - near-ultrasonic
  - MFSK
  - Reed-Solomon
  - ESP32
