# Generic ESP32-S3 module (no PSRAM needed: the demodulator state is ~46 KB of internal RAM).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Demodulator: FFT float32 engine, 48 kHz. The session layer listens to the four ladder bands and, with BYSOUND_DEMO_ROBUST_RX (default y,
# which selects BYSOUND_DEMOD_ROBUST), to both profiles with two demodulators. No audible bank.
CONFIG_BYSOUND_DEMOD_ENGINE_FFT=y
CONFIG_BYSOUND_DEMOD_MAX_RATE=48000
