menu "bysound demo"

    choice BYSOUND_DEMO_SECURITY
        prompt "Security level (docs/SESSION.md section 7)"
        default BYSOUND_DEMO_SECURITY_MAXIMUM
        help
            maximum (default): pre-listen 3-4.2 s, detects other emitters, risk frames, confirm watch. standard: 2-2.6 s. basic: integrity only (1 s pre-listen
            for the ambient check, nothing else heard is acted on).
        config BYSOUND_DEMO_SECURITY_BASIC
            bool "basic"
        config BYSOUND_DEMO_SECURITY_STANDARD
            bool "standard"
        config BYSOUND_DEMO_SECURITY_MAXIMUM
            bool "maximum"
    endchoice

    config BYSOUND_DEMO_FIXED_BAND
        bool "Send on one band only (no channel ladder, no calibration)"
        default n
        help
            By default the sender picks a channel by the noise it measures and steps down the ladder top, high, upper, mid until it is acknowledged
            (docs/SESSION.md section 9). Listening always covers the four ladder bands.

    config BYSOUND_DEMO_BAND
        int "Fixed band (0 top, 1 high, 2 upper, 3 mid)"
        default 0
        range 0 3
        depends on BYSOUND_DEMO_FIXED_BAND

    config BYSOUND_DEMO_ROBUST_RX
        bool "Also listen to the robust profile (second demodulator)"
        default y
        select BYSOUND_DEMOD_ROBUST
        help
            The sender goes robust after 6 repetitions without an ack (or in noise), so a receiver that only hears the normal profile misses it.
            Costs about 130 KB of RAM for the two demodulators in total (the robust-capable state is about 66 KB each; one demodulator of the normal
            profile only is about 45 KB).

    config BYSOUND_DEMO_TEXT
        string "Text sent when the button is pressed"
        default "hello from esp32"

    config BYSOUND_DEMO_TX_LEVEL
        int "Output level (percent of full scale)"
        default 100
        range 1 100
        help
            The modem is meant to run at full scale; lower this only if your amplifier clips.

    config BYSOUND_DEMO_MIC_GAIN_SHIFT
        int "Digital microphone gain (left shift, 2^n)"
        default 2
        range 0 6
        help
            The INMP441 is quiet at 18 kHz. The 16 top bits of its 24-bit sample are multiplied by 2^n (with saturation).

    config BYSOUND_DEMO_RX_MAX_BYTES
        int "Largest received payload (packed bytes)"
        default 1024
        range 48 12244
        help
            Size of the buffer handed to the demodulator. A frame that does not fit is dropped.

    config BYSOUND_DEMO_BUTTON_GPIO
        int "Button GPIO (active low)"
        default 0
        help
            GPIO0 is the BOOT button on most ESP32-S3 dev boards.

    menu "Microphone (INMP441, I2S port 1)"
        config BYSOUND_DEMO_MIC_BCLK
            int "SCK (bit clock) GPIO"
            default 4
        config BYSOUND_DEMO_MIC_WS
            int "WS (word select) GPIO"
            default 5
        config BYSOUND_DEMO_MIC_SD
            int "SD (data out of the microphone) GPIO"
            default 6
    endmenu

    menu "Amplifier (MAX98357A, I2S port 0)"
        config BYSOUND_DEMO_SPK_BCLK
            int "BCLK GPIO"
            default 15
        config BYSOUND_DEMO_SPK_WS
            int "LRC (word select) GPIO"
            default 16
        config BYSOUND_DEMO_SPK_DIN
            int "DIN (data into the amplifier) GPIO"
            default 17
    endmenu

endmenu
