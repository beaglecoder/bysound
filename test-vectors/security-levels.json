{
  "comment": "Security levels of the bysound session layer (docs/SESSION.md section 7). Every implementation must resolve exactly these values; an explicit option always wins over the level. 'maximum' is the default. Values are copied from the original library; fields of features that are not part of the public release (energy detector, short listens) are left out.",
  "default": "maximum",
  "levels": {
    "basic": {
      "detectMultipleEmitters": false,
      "listenWhileSending": false,
      "listenBeforeSendingSeconds": 1,
      "scanJitterSeconds": 0.6,
      "confirmWatch": false,
      "confirmWatchSeconds": 120,
      "riskSignal": { "emit": "off", "listen": false, "honor": false, "listenUntil": "delivery", "durationMs": 4000, "detectorDurationMs": 4000, "quarantineMs": 30000 }
    },
    "standard": {
      "detectMultipleEmitters": true,
      "listenWhileSending": true,
      "listenBeforeSendingSeconds": 2,
      "scanJitterSeconds": 0.6,
      "confirmWatch": true,
      "confirmWatchSeconds": 120,
      "riskSignal": { "emit": "auto", "listen": true, "honor": true, "listenUntil": "confirm", "durationMs": 4000, "detectorDurationMs": 15000, "quarantineMs": 30000 }
    },
    "maximum": {
      "detectMultipleEmitters": true,
      "listenWhileSending": true,
      "listenBeforeSendingSeconds": 3,
      "scanJitterSeconds": 1.2,
      "confirmWatch": true,
      "confirmWatchSeconds": 120,
      "riskSignal": { "emit": "auto", "listen": true, "honor": true, "listenUntil": "confirm", "durationMs": 6000, "detectorDurationMs": 30000, "quarantineMs": 60000 }
    }
  }
}
